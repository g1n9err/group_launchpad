# ── Group Launchpad — environment template ─────────────────────────────────
# Copy to .env and adjust. NEVER commit the real .env (git-ignored).

# ── Backend (api + worker) ─────────────────────────────────────────────────
# Local docker compose Postgres. In production: managed Postgres DSN.
DATABASE_URL=postgres://launchpad:launchpad@localhost:5432/launchpad?sslmode=disable

# HTTP port for the API (default 8080)
PORT=8080

# debug | info | warn | error
LOG_LEVEL=info

# Apply pending migrations when the API boots (dev convenience — production
# pipelines run `go run ./cmd/migrate up` as an explicit deploy step).
MIGRATE_ON_BOOT=true

# Browser origins allowed to call the API (comma-separated). Local dev uses the
# Vite dev server; production adds the Vercel domain.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# HTTP Basic coordinator password. Generate with openssl rand -hex 32.
# Empty leaves coordinator-only routes unavailable.
COORDINATOR_PASSWORD=

# ── Day 2+ integrations — EMPTY until real credentials exist ───────────────
# An empty value disables the adapter entirely. Nothing simulates a real
# integration. Obtain credentials for the organization's Slack workspace and
# Google Cloud project (see README "Integration prerequisites").
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the Google Cloud Console "Authorized redirect URI" exactly.
# http://localhost:8080/api/integrations/google/callback
GOOGLE_REDIRECT_URL=
# 32-byte base64 key encrypting stored OAuth refresh tokens (AES-256-GCM).
# Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ── Frontend (Vite) ────────────────────────────────────────────────────────
# VITE_ variables are baked into the browser bundle — public values ONLY.
# Empty in dev (the Vite dev server proxies /api to localhost:8080); set to
# the public API origin in production builds, e.g. https://api.example.com
# VITE_API_URL=
