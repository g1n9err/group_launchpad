# ── Group Launchpad — environment template ─────────────────────────────────
# Copy to .env and adjust. NEVER commit the real .env (git-ignored).

# ── Backend (api + worker) ─────────────────────────────────────────────────
# Local docker compose Postgres. In production: managed Postgres DSN.
DATABASE_URL=postgres://launchpad:launchpad@localhost:5432/launchpad?sslmode=disable

# HTTP port for the API (default 8080)
PORT=8080

# debug | info | warn | error
LOG_LEVEL=info

# Apply pending migrations when the API boots (dev convenience — production
# pipelines run `go run ./cmd/migrate up` as an explicit deploy step).
MIGRATE_ON_BOOT=true

# Browser origins allowed to call the API (comma-separated). Local dev uses the
# Vite dev server; production adds the Vercel domain.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# HTTP Basic coordinator password (legacy shared account). Generate with
# openssl rand -hex 32. Empty leaves coordinator-only routes unavailable.
COORDINATOR_PASSWORD=

# ── Multi-role authentication (PRD §3, §7.4) ────────────────────────────────
# Lifetime of bearer sessions issued by POST /api/auth/login.
AUTH_SESSION_TTL=12h
# Brute-force throttle: failed logins per IP+email before 429 RATE_LIMITED.
# Per-account (3x) and per-IP (10x) caps are derived. Counters are in-memory
# and PER PROCESS — not a distributed rate limiter.
LOGIN_RATE_MAX=10
LOGIN_RATE_WINDOW=5m
# Set true ONLY behind a reverse proxy that OVERWRITES X-Forwarded-For;
# enables XFF-based client-IP attribution for the throttle. Default false.
TRUST_PROXY=false
# One-time bootstrap: created on first boot ONLY if no admin exists.
# Remove after the first login; the password is stored as a bcrypt hash.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Comma-separated staff emails for Drive/Classroom access (editors/teachers).
# Deprecated fallback: per-group staff_assignments and the admin-managed
# predefined staff list (PRD §3.2) take precedence.
STAFF_EMAILS=

# ── Day 2+ integrations — EMPTY until real credentials exist ───────────────
# An empty value disables the adapter entirely. Nothing simulates a real
# integration. Obtain credentials for the organization's Slack workspace and
# Google Cloud project (see README "Integration prerequisites").
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
# Public HTTPS API origin. Set this to the tunnel origin for local Slack OAuth.
PUBLIC_API_BASE_URL=
# Optional exact callback override; otherwise derived from PUBLIC_API_BASE_URL.
SLACK_OAUTH_REDIRECT_URI=
# Legacy alias; prefer SLACK_OAUTH_REDIRECT_URI.
SLACK_OAUTH_REDIRECT_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the Google Cloud Console "Authorized redirect URI" exactly.
# http://localhost:8080/api/integrations/google/callback
GOOGLE_REDIRECT_URL=
# 32-byte base64 key encrypting stored OAuth refresh tokens (AES-256-GCM).
# Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Coordinator inbox for changed audit findings. Empty disables audit email.
AUDIT_NOTIFICATION_EMAIL=

# Intake form email delivery. Enable Gmail OAuth or a STARTTLS SMTP relay.
GMAIL_ENABLED=false
# Username and password may both be empty for a trusted relay.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Public HTTPS frontend URL. Set alongside GMAIL_ENABLED and Google OAuth configuration.
PASSWORD_RESET_SITE_URL=
# Integration UUID of the operator-controlled Gmail sender for recovery messages.
PASSWORD_RESET_GMAIL_ACCOUNT_ID=
# Server-side key for Google Cloud Translation Basic.
GOOGLE_TRANSLATION_API_KEY=

# ── Frontend (Vite) ────────────────────────────────────────────────────────
# VITE_ variables are baked into the browser bundle — public values ONLY.
# Empty in dev (the Vite dev server proxies /api to localhost:8080); set to
# the public API origin in production builds, e.g. https://api.example.com
# VITE_API_URL=
