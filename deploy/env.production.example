# ── Group Launchpad — PRODUCTION environment template ──────────────────────
# Copy to deploy/.env.production and fill in. NEVER commit the filled file.
# Generate secrets with:  openssl rand -hex 32   /   openssl rand -base64 32

# ── Database (compose-internal) ────────────────────────────────────────────
POSTGRES_USER=launchpad
POSTGRES_PASSWORD=            # openssl rand -hex 32
POSTGRES_DB=launchpad

LOG_LEVEL=info
MIGRATE_ON_BOOT=true          # or run `cmd/migrate up` explicitly first

# ── Auth ───────────────────────────────────────────────────────────────────
# Legacy shared Basic account (username "coordinator"), >= 32 chars.
COORDINATOR_PASSWORD=         # openssl rand -hex 32
AUTH_SESSION_TTL=12h
LOGIN_RATE_MAX=10
LOGIN_RATE_WINDOW=5m
# true ONLY behind a reverse proxy that OVERWRITES X-Forwarded-For.
TRUST_PROXY=true

# ── ONE-TIME admin bootstrap ───────────────────────────────────────────────
# Fill both, boot once, log in once, then DELETE both lines and recreate the
# api container. The password is stored only as a bcrypt hash.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=       # >= 12 chars, <= 72 (bcrypt limit)

# ── Browser origin (SPA) — must match the public HTTPS URL exactly ─────────
CORS_ALLOWED_ORIGINS=https://launchpad.example.am

# ── Integrations (leave empty to keep them disabled / 503) ─────────────────
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# For installing one Launchpad Slack app into multiple workspaces, configure
# OAuth v2 in Slack and register this callback URL in the app settings.
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
# Public HTTPS API origin; callback URI is derived by appending the fixed route.
PUBLIC_API_BASE_URL=https://launchpad.example.am
# Optional exact override. Must also be registered in Slack OAuth & Permissions.
SLACK_OAUTH_REDIRECT_URI=
# Google OAuth — redirect URI registered in Google Cloud Console, e.g.
# https://launchpad.example.am/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=
# 32-byte base64 key encrypting stored OAuth refresh tokens (AES-256-GCM).
TOKEN_ENCRYPTION_KEY=         # openssl rand -base64 32

# ── Worker options ─────────────────────────────────────────────────────────
STAFF_EMAILS=                 # legacy fallback; prefer predefined staff API
AUDIT_NOTIFICATION_EMAIL=     # empty disables audit summary email
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
GMAIL_ENABLED=false
